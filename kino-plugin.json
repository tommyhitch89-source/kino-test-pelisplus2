
{
  "id": "pelisplushd",
  "name": "PelisplusHD",
  "version": "1.0.116",
  "apiVersion": 6,
  "description": "Catálogo de películas, series, anime y doramas de PelisplusHD con verificación manual de reproductores externos.",
  "entry": "plugin.js",
  "hosts": [
    "pelisplushd.bz",
    "image.tmdb.org",
    "streamwish.to",
    "filemoon.sx",
    "vidhide.com",
    "ok.ru",
    "voe.sx"
  ],
  "streamHosts": "any",
  "browser": true,
  "capabilities": [
    "home",
    "search",
    "browse",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "captchaUrl",
      "label": "Dirección del reproductor que necesita verificación",
      "type": "text"
    },
    {
      "key": "openCaptcha",
      "label": "Abrir reproductor para verificar CAPTCHA",
      "type": "action"
    }
  ],
  "enhancements": {
    "20": {
      "visualBrowser": true
    }
  }
}
